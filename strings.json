{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect to WARP Charger",
        "description": "Enter the hostname or IP address of your Tinkerforge WARP charger. Username and password are required if HTTP authentication is enabled on the charger.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "host": "IP address or hostname without scheme, e.g. 192.168.178.15",
          "verify_ssl": "Leave off for the charger's self-signed certificate"
        }
      },
      "zeroconf_confirm": {
        "title": "Discovered WARP Charger",
        "description": "Set up {name} at {host}? Username and password are required if HTTP authentication is enabled on the charger.",
        "data": {
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate WARP Charger",
        "description": "The charger at {host} requires (new) credentials.",
        "data": {
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        }
      },
      "reconfigure": {
        "title": "Reconfigure WARP Charger",
        "description": "Change host, credentials or TLS verification for the charger at {host}. Leave the password empty to keep the stored one.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the charger",
      "invalid_auth": "Invalid username or password",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This charger is already configured",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Reconfiguration was successful",
      "not_supported": "This device is not a WARP charger",
      "wrong_device": "The charger at this address is a different device than the configured one"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "WARP Charger options",
        "data": {
          "use_websocket": "Push updates via WebSocket",
          "scan_interval": "Polling interval (fallback)"
        },
        "data_description": {
          "use_websocket": "Receive state changes instantly from the charger. Polling is only used as a fallback.",
          "scan_interval": "Seconds between HTTP polls while the WebSocket is not connected."
        }
      }
    }
  },
  "selector": {
    "charge_mode": {
      "options": {
        "fast": "Fast",
        "off": "Off",
        "pv": "PV",
        "min_pv": "Min + PV",
        "min": "Min",
        "eco": "Eco",
        "eco_pv": "Eco + PV",
        "eco_min": "Eco + Min",
        "eco_min_pv": "Eco + Min + PV"
      }
    },
    "duration_limit": {
      "options": {
        "unlimited": "Unlimited",
        "15_min": "15 minutes",
        "30_min": "30 minutes",
        "45_min": "45 minutes",
        "1_h": "1 hour",
        "2_h": "2 hours",
        "3_h": "3 hours",
        "4_h": "4 hours",
        "6_h": "6 hours",
        "8_h": "8 hours",
        "12_h": "12 hours"
      }
    },
    "nfc_action": {
      "options": {
        "toggle": "Toggle",
        "start": "Start",
        "stop": "Stop"
      }
    }
  },
  "services": {
    "set_charge_mode": {
      "name": "Set charge mode",
      "description": "Sets the power manager charge mode of the charger.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The WARP charger device."
        },
        "mode": {
          "name": "Mode",
          "description": "Charge mode to activate."
        }
      }
    },
    "set_charge_limits": {
      "name": "Set charge limits",
      "description": "Sets energy, duration or SoC limits for charging sessions.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The WARP charger device."
        },
        "energy_kwh": {
          "name": "Energy limit",
          "description": "Energy limit in kWh, 0 = unlimited."
        },
        "duration": {
          "name": "Duration limit",
          "description": "Maximum charging duration."
        },
        "soc_pct": {
          "name": "SoC limit",
          "description": "Target vehicle state of charge in % (WARP4, default limits only)."
        },
        "override": {
          "name": "Only current session",
          "description": "Apply to the running session instead of changing the defaults."
        }
      }
    },
    "set_external_current": {
      "name": "Set external current",
      "description": "Sets the external control current limit. 0 A blocks charging.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The WARP charger device."
        },
        "current_a": {
          "name": "Current",
          "description": "0 or 6–32 A."
        }
      }
    },
    "inject_soc": {
      "name": "Inject vehicle SoC",
      "description": "Tells the charger the vehicle's state of charge (WARP4).",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The WARP charger device."
        },
        "soc_pct": {
          "name": "SoC",
          "description": "State of charge in %."
        }
      }
    },
    "inject_nfc_tag": {
      "name": "Simulate NFC tag",
      "description": "Simulates presenting an NFC tag to start or stop charging.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The WARP charger device."
        },
        "tag_id": {
          "name": "Tag-ID",
          "description": "Tag id, e.g. 01:23:AB:3D."
        },
        "tag_type": {
          "name": "Tag type",
          "description": "0 Mifare Classic, 1–4 NFC Forum Type 1–4."
        },
        "action": {
          "name": "Action",
          "description": "Toggle, start or stop."
        }
      }
    }
  },
