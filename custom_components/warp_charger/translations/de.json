{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Mit WARP Charger verbinden",
        "description": "Hostname oder IP-Adresse des Tinkerforge WARP Chargers eingeben. Benutzername und Passwort sind erforderlich, wenn die HTTP-Authentifizierung am Charger aktiviert ist.",
        "data": {
          "host": "Host",
          "username": "Benutzername",
          "password": "Passwort",
          "verify_ssl": "SSL-Zertifikat prüfen"
        },
        "data_description": {
          "host": "IP-Adresse oder Hostname ohne Schema, z. B. 192.168.178.15",
          "verify_ssl": "Für das selbstsignierte Zertifikat des Chargers ausgeschaltet lassen"
        }
      },
      "zeroconf_confirm": {
        "title": "WARP Charger gefunden",
        "description": "{name} unter {host} einrichten? Benutzername und Passwort sind erforderlich, wenn die HTTP-Authentifizierung am Charger aktiviert ist.",
        "data": {
          "username": "Benutzername",
          "password": "Passwort",
          "verify_ssl": "SSL-Zertifikat prüfen"
        }
      },
      "reauth_confirm": {
        "title": "WARP Charger erneut authentifizieren",
        "description": "Der Charger unter {host} benötigt (neue) Zugangsdaten.",
        "data": {
          "username": "Benutzername",
          "password": "Passwort",
          "verify_ssl": "SSL-Zertifikat prüfen"
        }
      },
      "reconfigure": {
        "title": "WARP Charger neu konfigurieren",
        "description": "Host, Zugangsdaten oder TLS-Prüfung für den Charger unter {host} ändern. Passwort leer lassen, um das gespeicherte zu behalten.",
        "data": {
          "host": "Host",
          "username": "Benutzername",
          "password": "Passwort",
          "verify_ssl": "SSL-Zertifikat prüfen"
        }
      }
